<Window x:Class="GlyphFrame.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="About GlyphFrame"
        Width="470"
        Height="310"
        MinWidth="420"
        MinHeight="290"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None">
    <Border Background="{StaticResource MainBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="68" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="18,0,10,0"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="About GlyphFrame" />
                    <Button Grid.Column="1"
                            Width="34"
                            Height="30"
                            Padding="0"
                            automation:AutomationProperties.Name="Close About dialog"
                            Click="CloseButton_Click"
                            Style="{StaticResource TextButtonStyle}"
                            ToolTip="Close About dialog">
                        <Path Width="10"
                              Height="10"
                              Data="M 0,0 L 10,10 M 10,0 L 0,10"
                              Stroke="{StaticResource PrimaryTextBrush}"
                              StrokeEndLineCap="Round"
                              StrokeStartLineCap="Round"
                              StrokeThickness="1.5" />
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="26,22,26,18">
                <StackPanel Orientation="Horizontal">
                    <Border Width="48"
                            Height="48"
                            Margin="0,0,14,0"
                            Background="{DynamicResource AccentSubtleBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentHoverBrush}"
                                   Text="GF" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Text="{Binding Name}" />
                        <TextBlock Margin="0,3,0,0"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Text="{Binding VersionText}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Margin="0,20,0,0"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           Text="Video and image to symbol art"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           LineHeight="19"
                           Text="Media processing stays on this computer. GlyphFrame does not upload media or send telemetry."
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="2"
                    Padding="24,14"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10">
                <Button x:Name="CloseButton"
                        MinWidth="100"
                        HorizontalAlignment="Right"
                        automation:AutomationProperties.Name="Close About dialog"
                        Click="CloseButton_Click"
                        Content="Close"
                        IsCancel="True"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </Border>
        </Grid>
    </Border>
</Window>
