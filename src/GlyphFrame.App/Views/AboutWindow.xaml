<Window x:Class="GlyphFrame.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GlyphFrame.App.Views"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="About GlyphFrame"
        Width="520"
        SizeToContent="Height"
        MinWidth="420"
        MinHeight="290"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None">
    <Border Background="{StaticResource MainBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="18,0,10,0"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="About GlyphFrame" />
                    <Button Grid.Column="1"
                            Width="34"
                            Height="30"
                            Padding="0"
                            automation:AutomationProperties.Name="Close About dialog"
                            Click="CloseButton_Click"
                            Style="{StaticResource TextButtonStyle}"
                            ToolTip="Close About dialog">
                        <Path Width="10"
                              Height="10"
                              Data="M 0,0 L 10,10 M 10,0 L 0,10"
                              Stroke="{StaticResource PrimaryTextBrush}"
                              StrokeEndLineCap="Round"
                              StrokeStartLineCap="Round"
                              StrokeThickness="1.5" />
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="26,22,26,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <views:BrandLogo Margin="0,0,14,0" VerticalAlignment="Center"
                                         Style="{StaticResource BrandLogoStyle}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,3,0,0" Style="{StaticResource SecondaryTextStyle}"
                                       Text="{Binding VersionText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Margin="0,20,0,0" Text="Turn videos and images into symbol art." TextWrapping="Wrap" />
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource SecondaryTextBrush}"
                               Text="Render, preview, and export your results in one workspace." TextWrapping="Wrap" />
                    <TextBlock Margin="0,18,0,0" FontWeight="SemiBold" Text="Privacy" />
                    <TextBlock Margin="0,6,0,0" Foreground="{StaticResource SecondaryTextBrush}"
                               Text="Processing runs locally on your computer. GlyphFrame does not upload your media or send telemetry."
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,18,0,0" FontWeight="SemiBold" Text="Third-party software" />
                    <TextBlock Margin="0,6,0,0" Foreground="{StaticResource SecondaryTextBrush}"
                               Text="Includes FFmpeg and SkiaSharp. See the third-party notices for details." TextWrapping="Wrap" />
                    <Button Height="Auto" MinHeight="30" x:Name="ThirdPartyNoticesButton" Margin="0,8,0,0" HorizontalAlignment="Left"
                            Padding="8,4" FontWeight="Normal"
                            Content="Third-party notices" Click="ThirdPartyNotices_Click"
                            Style="{StaticResource {x:Type Button}}" />
                    <TextBlock x:Name="NoticesFeedback" Margin="0,8,0,0" Visibility="Collapsed"
                               Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap"
                               automation:AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Padding="24,14"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10">
                <Button Height="Auto" MinHeight="{StaticResource ControlHeight}" x:Name="CloseButton"
                        MinWidth="100"
                        HorizontalAlignment="Right"
                        automation:AutomationProperties.Name="Close About dialog"
                        Click="CloseButton_Click"
                        Content="Close"
                        IsCancel="True"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </Border>
        </Grid>
    </Border>
</Window>
