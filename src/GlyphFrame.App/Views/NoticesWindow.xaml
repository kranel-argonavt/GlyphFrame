<Window x:Class="GlyphFrame.App.Views.NoticesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Third-party notices — GlyphFrame" Width="760" Height="580" MinWidth="420" MinHeight="280"
        Background="{StaticResource MainBackgroundBrush}" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBox x:Name="DocumentText" Margin="20" Padding="12"
                 AutomationProperties.Name="Complete third-party notices"
                 Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" Height="Auto"
                 TextWrapping="Wrap" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" />
        <Border Grid.Row="1" Padding="24,14" Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Button Height="Auto" MinHeight="{StaticResource ControlHeight}" x:Name="CloseButton" HorizontalAlignment="Right" MinWidth="100" Content="Close"
                    AutomationProperties.Name="Close third-party notices" IsCancel="True"
                    Click="CloseButton_Click" Style="{StaticResource PrimaryButtonStyle}" />
        </Border>
    </Grid>
</Window>
