<UserControl x:Class="GlyphFrame.App.Views.PreviewPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:GlyphFrame.App.Behaviors"
             xmlns:views="clr-namespace:GlyphFrame.App.Views"
             MinHeight="360"
             Focusable="False">
    <Border Style="{StaticResource PreviewCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="44" Visibility="{Binding IsMediaSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="OriginalPreviewTab" Grid.Column="0"
                              AutomationProperties.Name="Original preview"
                              Command="{Binding SelectOriginalCommand}"
                              Style="{StaticResource OriginalPreviewTabStyle}"
                              ToolTip="Show the original media preview">
                    <StackPanel Orientation="Horizontal">
                        <Path Margin="0,0,8,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                            <Path.Style>
                                <Style TargetType="Path" BasedOn="{StaticResource VectorIconStyle}">
                                    <Setter Property="Data" Value="{StaticResource ImageIcon}" />
                                    <Style.Triggers><DataTrigger Binding="{Binding IsVideoSelected}" Value="True"><Setter Property="Data" Value="{StaticResource VideoIcon}" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <TextBlock Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Text="Original" />
                    </StackPanel>
                </Button>
                <Button x:Name="SymbolizedPreviewTab" Grid.Column="1"
                              AutomationProperties.Name="Symbolized preview"
                              Command="{Binding SelectSymbolizedCommand}"
                              Style="{StaticResource SymbolizedPreviewTabStyle}"
                              ToolTip="Show the generated symbolized preview">
                    <StackPanel Orientation="Horizontal">
                        <Path Margin="0,0,8,0" Style="{StaticResource VectorIconStyle}" Data="{StaticResource SymbolsIcon}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" Text="Symbolized" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Grid.Row="1"
                    behaviors:MediaDropBehavior.Command="{Binding DropMediaCommand}"
                    behaviors:MediaDropBehavior.IsEnabled="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource PreviewBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        <Setter Property="BorderThickness" Value="0,1" />
                        <Style.Triggers>
                            <Trigger Property="behaviors:MediaDropBehavior.IsDragOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid Background="Transparent" ClipToBounds="True">
                    <views:ReviewViewport x:Name="ImageViewport" ImageFrame="{Binding CurrentImageFrame}"
                                          ImageNavigation="{Binding ImageNavigation}"
                                          Source="{Binding CurrentPreviewImageSource}"
                                          PixelWidth="{Binding CurrentPreviewPixelWidth}" PixelHeight="{Binding CurrentPreviewPixelHeight}"
                                          ScaleMode="{Binding SelectedFitMode}"
                                          Visibility="{Binding ShowImagePreview, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <views:VideoReviewSurface
                        PlaybackKind="Original"
                        Visibility="{Binding ShowOriginalVideoPlayer, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <views:VideoReviewSurface Visibility="{Binding ShowRenderedVideoPlayer, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <Border
                        Margin="18"
                        Padding="10,6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Background="#CC151820"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="{Binding ShowOriginalPlaybackOpening, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            Foreground="{StaticResource SecondaryTextBrush}"
                            Text="Opening continuous Original playback…"
                            TextAlignment="Center" />
                    </Border>

                    <Border
                        Margin="18"
                        Padding="12,8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Background="#E6151820"
                        BorderBrush="{StaticResource WarningBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="{Binding ShowOriginalPlaybackFallback, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel MaxWidth="560">
                            <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="{Binding OriginalVideoPlaybackLimitationMessage}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <Button Margin="0,5,0,0"
                                    HorizontalAlignment="Center"
                                    Command="{Binding ShowOriginalPlaybackErrorDetailsCommand}"
                                    Content="Show Details"
                                    Style="{StaticResource TextButtonStyle}"
                                    Visibility="{Binding ShowOriginalPlaybackErrorDetails, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="18"
                            Padding="12,7"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Background="#CC151820"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="{Binding ShowPreviewStatusBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                                   Text="{Binding PreviewStaleMessage}"
                                   TextAlignment="Center" />
                    </Border>

                    <Grid Visibility="{Binding ShowEmptyPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel MaxWidth="520"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    TextBlock.TextAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Width="64" Height="64" Margin="0,0,16,0" Style="{StaticResource HeadingIconStyle}" Data="{StaticResource VideoIcon}" />
                                <Path Width="64" Height="64" Style="{StaticResource HeadingIconStyle}" Data="{StaticResource ImageIcon}" />
                            </StackPanel>
                            <TextBlock Margin="0,20,0,0"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Text="Choose an image or video" />
                            <TextBlock Margin="0,12,0,0"
                                       FontSize="13"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="Drop a local file here or browse your computer." TextWrapping="Wrap" />
                            <Button Width="154"
                                    Height="40"
                                    Margin="0,20,0,0"
                                    Command="{Binding BrowseMediaCommand}"
                                    Content="Browse Media"
                                    Tag="{StaticResource FolderIcon}" ContentTemplate="{StaticResource IconActionContent}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <TextBlock Margin="0,16,0,0" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                                       Text="PNG, JPG/JPEG, WebP, BMP • MP4, MOV, MKV, AVI" />
                            <TextBlock Margin="0,12,0,0" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                                       Text="Processed locally. No uploads or telemetry." />
                        </StackPanel>
                    </Grid>

                    <Grid Visibility="{Binding ShowLoadingPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel MaxWidth="520"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    TextBlock.TextAlignment="Center">
                            <TextBlock FontSize="22"
                                       FontWeight="SemiBold"
                                       Text="{Binding SelectedFileName}" />
                            <TextBlock Margin="0,12,0,0"
                                       FontSize="15"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="Reading local media metadata..." />
                            <ProgressBar Width="260"
                                         Height="5"
                                         Margin="0,22,0,0"
                                         IsIndeterminate="True" />
                            <TextBlock Margin="0,14,0,0"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="No media is uploaded or copied" />
                        </StackPanel>
                    </Grid>

                    <Grid Visibility="{Binding ShowErrorPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel MaxWidth="540"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    TextBlock.TextAlignment="Center">
                            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Media could not be loaded" />
                            <TextBlock Margin="0,12,0,0"
                                       FontSize="15"
                                       Foreground="{StaticResource ErrorBrush}"
                                       Text="{Binding InputStatusMessage}"
                                       TextWrapping="Wrap" />
                            <Button Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    Command="{Binding ShowMediaInputErrorDetailsCommand}"
                                    Content="Show Details"
                                    Style="{StaticResource TextButtonStyle}"
                                    Visibility="{Binding ShowMediaInputErrorDetails, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Width="154"
                                    Height="40"
                                    Margin="0,20,0,0"
                                    Command="{Binding BrowseMediaCommand}"
                                    Content="Choose Another"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid Visibility="{Binding ShowMediaPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.TextAlignment="Center">
                            <TextBlock FontSize="30" FontWeight="SemiBold" Text="Video selected" />
                            <TextBlock Margin="0,12,0,0"
                                       FontSize="18"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="Choose a position to load an original frame" />
                            <TextBlock Margin="0,10,0,0"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="{Binding InputMetadataSummary}" />
                        </StackPanel>
                    </Grid>

                    <Border Background="#C90D0F14"
                            Visibility="{Binding ShowVideoFrameLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel MaxWidth="520"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    TextBlock.TextAlignment="Center">
                            <TextBlock FontSize="24"
                                       FontWeight="SemiBold"
                                       Text="Loading video frame..." />
                            <TextBlock Margin="0,12,0,0"
                                       FontSize="15"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="{Binding TimelineText}" />
                            <ProgressBar Width="280"
                                         Height="5"
                                         Margin="0,22,0,0"
                                         IsIndeterminate="True" />
                            <TextBlock Margin="0,14,0,0"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="Decoding one local frame without loading the whole video" />
                        </StackPanel>
                    </Border>

                    <Border Background="#E60D0F14"
                            Visibility="{Binding ShowVideoFrameError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel MaxWidth="560"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    TextBlock.TextAlignment="Center">
                            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Frame preview unavailable" />
                            <TextBlock Margin="0,12,0,0"
                                       FontSize="15"
                                       Foreground="{StaticResource ErrorBrush}"
                                       Text="{Binding VideoFrameStatusMessage}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,12,0,0"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="Move the position slider to retry, or choose another video."
                                       TextWrapping="Wrap" />
                            <Button Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    Command="{Binding ShowVideoFrameErrorDetailsCommand}"
                                    Content="Show Details"
                                    Style="{StaticResource TextButtonStyle}"
                                    Visibility="{Binding ShowVideoFrameErrorDetails, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>

                    <Border Background="#E60D0F14"
                            Visibility="{Binding ShowRenderedVideoReviewError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel MaxWidth="560"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    TextBlock.TextAlignment="Center">
                            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Rendered video review unavailable" />
                            <TextBlock Margin="0,12,0,0"
                                       FontSize="15"
                                       Foreground="{StaticResource ErrorBrush}"
                                       Text="{Binding VideoReviewErrorPresentation.UserMessage}"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,12,0,0"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="The managed artifact is retained. Use Render Again to retry."
                                       TextWrapping="Wrap" />
                            <Button Margin="0,8,0,0"
                                    HorizontalAlignment="Center"
                                    Command="{Binding ShowVideoReviewErrorDetailsCommand}"
                                    Content="Show Details"
                                    Style="{StaticResource TextButtonStyle}"
                                    Visibility="{Binding ShowVideoReviewErrorDetails, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>

                    <Border Background="#D90D0F14"
                            Visibility="{Binding IsExportActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <views:ExportActivityIndicator Width="64"
                                                       Height="64"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       AnimationsEnabled="{Binding AreExportAnimationsEnabled}"
                                                       IsActive="{Binding IsExportActive}"
                                                       IsCompleted="False"
                                                       ShowPercentageText="False" />
                    </Border>
                </Grid>

            </Border>

            <Grid Grid.Row="2"
                  Margin="14,10"
                  Visibility="{Binding ShowVideoFrameControls, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Frame position" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Grid.Column="1"
                           Margin="10,0,12,0"
                           Style="{StaticResource MutedTextStyle}"
                           Text="{Binding TimelineText}"
                           VerticalAlignment="Center" />
                <Slider Grid.Column="2"
                        Margin="0,0,12,0"
                        IsEnabled="{Binding IsVideoSeekEnabled}"
                        Maximum="1"
                        Minimum="0"
                        SmallChange="0.01"
                        LargeChange="0.1"
                        ToolTip="Select an original video frame (not playback)"
                        AutomationProperties.Name="Original frame position"
                        Style="{DynamicResource PlayerSliderStyle}"
                        Value="{Binding TimelinePosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Grid.Column="3"
                          Width="92"
                          Margin="0,0,8,0"
                          ItemsSource="{Binding FitModes}"
                          SelectedItem="{Binding SelectedFitMode}"
                          ToolTip="Preview scaling" AutomationProperties.Name="Frame review scale" />

            </Grid>

            <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                    Visibility="{Binding IsMediaSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="14,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" MinWidth="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Margin="0,0,8,0">
                                <Path.Style>
                                    <Style TargetType="Path" BasedOn="{StaticResource HeadingIconStyle}">
                                        <Setter Property="Data" Value="{StaticResource ImageIcon}" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsVideoSelected}" Value="True"><Setter Property="Data" Value="{StaticResource VideoIcon}" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Grid.Column="1"
                                       FontWeight="SemiBold"
                                       Text="{Binding SelectedFileName}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SelectedFileName}" />
                        </Grid>
                        <TextBlock Margin="0,5,0,0"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Text="{Binding MetadataPrimaryText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding MetadataPrimaryText}" />
                        <TextBlock Margin="0,3,0,0"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="{Binding MetadataSecondaryText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding MetadataSecondaryText}" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{StaticResource WarningBrush}"
                                   Text="Same as source is above 1080p; preview and export remain available."
                                   TextWrapping="Wrap"
                                   Visibility="{Binding ShowResolutionWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                    <Grid Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Button MinWidth="188"
                                Command="{Binding RenderImageCommand}"
                                Content="{Binding ImageRenderActionLabel}"
                                ContentTemplate="{StaticResource IconActionContent}"
                                Visibility="{Binding IsImageSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Tag" Value="{StaticResource RenderIcon}" />
                                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasImageResultForRerender}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ElevatedBackgroundBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                            <Setter Property="Tag" Value="{StaticResource RerenderIcon}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsVideoSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button MinWidth="132"
                                    AutomationProperties.HelpText="Available before a complete rendered video is accepted"
                                    AutomationProperties.Name="Preview the currently selected video frame"
                                    Command="{Binding PreviewFrameCommand}"
                                    Content="{Binding PreviewFrameActionLabel}"
                                    Visibility="{Binding ShowPreviewFrameAction, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button MinWidth="148"
                                    Margin="10,0,0,0"
                                    Command="{Binding RenderVideoCommand}"
                                    Content="{Binding VideoRenderActionLabel}"
                                    ContentTemplate="{StaticResource IconActionContent}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Tag" Value="{StaticResource RenderIcon}" />
                                        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentHoverBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasVideoArtifact}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource ElevatedBackgroundBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                                <Setter Property="Tag" Value="{StaticResource RerenderIcon}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
