<UserControl x:Class="GlyphFrame.App.Views.PreviewPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:GlyphFrame.App.Behaviors"
             MinHeight="420"
             Focusable="False">
    <Border Style="{StaticResource PreviewCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ToggleButton Grid.Column="0"
                              IsChecked="{Binding IsOriginalPreviewSelected, Mode=OneWay}"
                              Command="{Binding SelectOriginalCommand}"
                              Style="{StaticResource PreviewTabStyle}"
                              ToolTip="Show the original media preview">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}" Text="▣" />
                        <TextBlock Foreground="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}" Text="Original" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Grid.Column="1"
                              IsChecked="{Binding IsSymbolizedPreviewSelected, Mode=OneWay}"
                              Command="{Binding SelectSymbolizedCommand}"
                              Style="{StaticResource PreviewTabStyle}"
                              ToolTip="Show the generated symbolized preview">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,8,0" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}" Text="⠿" />
                        <TextBlock Foreground="{Binding RelativeSource={RelativeSource AncestorType=ToggleButton}, Path=Foreground}" Text="Symbolized" />
                    </StackPanel>
                </ToggleButton>
            </Grid>

            <Border Grid.Row="1"
                    behaviors:MediaDropBehavior.Command="{Binding DropMediaCommand}"
                    behaviors:MediaDropBehavior.IsEnabled="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource PreviewBackgroundBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        <Setter Property="BorderThickness" Value="0,1" />
                        <Style.Triggers>
                            <Trigger Property="behaviors:MediaDropBehavior.IsDragOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="BorderThickness" Value="2" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Viewbox Stretch="Uniform">
                    <Grid Width="960" Height="540" Background="Transparent">
                        <Grid Visibility="{Binding ShowEmptyPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Width="520"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        TextBlock.TextAlignment="Center">
                                <Border Width="74"
                                        Height="74"
                                        HorizontalAlignment="Center"
                                        Background="{DynamicResource AccentSubtleBrush}"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="2"
                                        CornerRadius="18">
                                    <Grid>
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="34"
                                                   Foreground="{DynamicResource AccentHoverBrush}"
                                                   Text="▶" />
                                    </Grid>
                                </Border>
                                <TextBlock Margin="0,20,0,0"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Text="Drop media here to begin" />
                                <TextBlock Margin="0,12,0,0"
                                           FontSize="13"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="Images and videos stay on this computer" />
                                <Button Width="154"
                                        Height="40"
                                        Margin="0,20,0,0"
                                        Command="{Binding BrowseMediaCommand}"
                                        Content="Browse Media"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                            </StackPanel>
                        </Grid>

                        <Grid Visibility="{Binding ShowLoadingPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Width="520"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        TextBlock.TextAlignment="Center">
                                <TextBlock FontSize="22"
                                           FontWeight="SemiBold"
                                           Text="{Binding SelectedFileName}" />
                                <TextBlock Margin="0,12,0,0"
                                           FontSize="15"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="Reading local media metadata..." />
                                <ProgressBar Width="260"
                                             Height="5"
                                             Margin="0,22,0,0"
                                             IsIndeterminate="True" />
                                <TextBlock Margin="0,14,0,0"
                                           Style="{StaticResource MutedTextStyle}"
                                           Text="No media is uploaded or copied" />
                            </StackPanel>
                        </Grid>

                        <Grid Visibility="{Binding ShowErrorPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Width="540"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        TextBlock.TextAlignment="Center">
                                <TextBlock FontSize="22" FontWeight="SemiBold" Text="Media could not be loaded" />
                                <TextBlock Margin="0,12,0,0"
                                           FontSize="15"
                                           Foreground="{StaticResource ErrorBrush}"
                                           Text="{Binding InputStatusMessage}"
                                           TextWrapping="Wrap" />
                                <Button Width="154"
                                        Height="40"
                                        Margin="0,20,0,0"
                                        Command="{Binding BrowseMediaCommand}"
                                        Content="Choose Another"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                            </StackPanel>
                        </Grid>

                        <Grid Visibility="{Binding ShowMediaPlaceholder, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.TextAlignment="Center">
                                <TextBlock FontSize="30" FontWeight="SemiBold" Text="Original media selected" />
                                <TextBlock Margin="0,12,0,0"
                                           FontSize="18"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="Pixel and frame previews are intentionally deferred" />
                                <TextBlock Margin="0,10,0,0"
                                           Style="{StaticResource MutedTextStyle}"
                                           Text="{Binding InputMetadataSummary}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Viewbox>
            </Border>

            <Grid Grid.Row="2"
                  Margin="14,10"
                  Visibility="{Binding IsVideoSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Width="34"
                        Height="32"
                        Padding="0"
                        Command="{Binding SelectOriginalCommand}"
                        Content="▶"
                        ToolTip="Video playback is not implemented in Phase 3" />
                <TextBlock Grid.Column="1"
                           Margin="10,0,12,0"
                           Style="{StaticResource MutedTextStyle}"
                           Text="{Binding TimelineText}"
                           VerticalAlignment="Center" />
                <Slider Grid.Column="2"
                        Margin="0,0,12,0"
                        IsEnabled="False"
                        Maximum="100"
                        Value="{Binding TimelinePosition}" />
                <ComboBox Grid.Column="3"
                          Width="82"
                          Margin="0,0,8,0"
                          ItemsSource="{Binding FitModes}"
                          SelectedItem="{Binding SelectedFitMode}"
                          ToolTip="Preview scaling" />
                <Button Grid.Column="4"
                        Width="36"
                        Padding="0"
                        Command="{Binding FullscreenCommand}"
                        Content="⛶"
                        ToolTip="Open fullscreen preview" />
            </Grid>

            <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="14,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0"
                                       Foreground="{DynamicResource AccentHoverBrush}"
                                       Text="▣" />
                            <TextBlock FontWeight="SemiBold" Text="{Binding SelectedFileName}" />
                            <TextBlock Margin="10,0,0,0"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="{Binding MediaTypeText}" />
                        </StackPanel>
                        <TextBlock Margin="0,5,0,0"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Text="{Binding MetadataPrimaryText}" />
                        <TextBlock Margin="0,3,0,0"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="{Binding MetadataSecondaryText}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            MinWidth="188"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Command="{Binding PreviewCommand}"
                            Content="{Binding PreviewActionLabel}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
