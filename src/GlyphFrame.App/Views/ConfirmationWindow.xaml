<Window x:Class="GlyphFrame.App.Views.ConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="{Binding Title}"
        Width="520"
        Height="268"
        MinWidth="460"
        MinHeight="240"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None">
    <Border Background="{StaticResource MainBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              Direction="270"
                              Opacity="0.5"
                              ShadowDepth="8"
                              Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="68" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="18,0,10,0"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="24"
                            Height="24"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentSubtleBrush}"
                            CornerRadius="6">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentHoverBrush}"
                                   Text="GF" />
                    </Border>

                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="{Binding Title}" />

                    <Button Grid.Column="2"
                            Width="34"
                            Height="30"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            automation:AutomationProperties.Name="Close confirmation"
                            Click="CancelButton_Click"
                            IsCancel="True"
                            Style="{StaticResource TextButtonStyle}"
                            ToolTip="Close">
                        <Path Width="10"
                              Height="10"
                              Data="M 0,0 L 10,10 M 10,0 L 0,10"
                              SnapsToDevicePixels="True"
                              Stretch="Fill"
                              Stroke="{StaticResource PrimaryTextBrush}"
                              StrokeEndLineCap="Round"
                              StrokeStartLineCap="Round"
                              StrokeThickness="1.5" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,22,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="40"
                        Height="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource ElevatedBackgroundBrush}"
                        BorderBrush="{StaticResource WarningBrush}"
                        BorderThickness="1"
                        CornerRadius="20">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource WarningBrush}"
                               Text="!" />
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               Text="{Binding Title}" />
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               LineHeight="20"
                               Text="{Binding Message}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2"
                    Padding="20,14,24,14"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button MinWidth="96"
                            automation:AutomationProperties.Name="{Binding CancelButtonText}"
                            Click="CancelButton_Click"
                            Content="{Binding CancelButtonText}"
                            IsCancel="True" />
                    <Button x:Name="ConfirmButton"
                            Width="144"
                            Margin="10,0,4,0"
                            automation:AutomationProperties.Name="{Binding ConfirmButtonText}"
                            Click="ConfirmButton_Click"
                            Content="{Binding ConfirmButtonText}"
                            IsDefault="True"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
