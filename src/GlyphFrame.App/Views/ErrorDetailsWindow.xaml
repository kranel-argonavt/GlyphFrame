<Window x:Class="GlyphFrame.App.Views.ErrorDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Error Details"
        Width="760"
        Height="580"
        MinWidth="560"
        MinHeight="420"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None">
    <Border Background="{StaticResource MainBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="68" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="18,0,10,0"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="24"
                            Height="24"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentSubtleBrush}"
                            CornerRadius="6">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentHoverBrush}"
                                   Text="GF" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="Error Details" />
                    <Button Grid.Column="2"
                            Width="34"
                            Height="30"
                            Padding="0"
                            automation:AutomationProperties.Name="Close error details"
                            Click="CloseButton_Click"
                            IsCancel="True"
                            Style="{StaticResource TextButtonStyle}"
                            ToolTip="Close">
                        <Path Width="10"
                              Height="10"
                              Data="M 0,0 L 10,10 M 10,0 L 0,10"
                              Stroke="{StaticResource PrimaryTextBrush}"
                              StrokeEndLineCap="Round"
                              StrokeStartLineCap="Round"
                              StrokeThickness="1.5" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,20,24,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="CODE" />
                    <TextBlock Grid.Column="1"
                               Margin="16,0,0,0"
                               Style="{StaticResource MonospaceTextStyle}"
                               Text="{Binding Code}" />
                </Grid>
                <Grid Grid.Row="1" Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="OPERATION" />
                    <TextBlock Grid.Column="1"
                               Margin="16,0,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               Text="{Binding Operation}" />
                </Grid>
                <Border Grid.Row="2"
                        Margin="0,16,0,14"
                        Padding="12,10"
                        Background="{StaticResource ElevatedBackgroundBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">
                    <TextBlock Foreground="{StaticResource PrimaryTextBrush}"
                               Text="{Binding Message}"
                               TextWrapping="Wrap" />
                </Border>
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="0,0,0,7"
                               Style="{StaticResource LabelTextStyle}"
                               Text="Technical details" />
                    <TextBox Grid.Row="1"
                             Height="Auto"
                             MinHeight="180"
                             Padding="12,10"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             automation:AutomationProperties.Name="Technical error details"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="12"
                             HorizontalScrollBarVisibility="Disabled"
                             IsReadOnly="True"
                             Text="{Binding TechnicalDetail, Mode=OneWay}"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Grid>

            <Border Grid.Row="2"
                    Padding="24,14"
                    Background="{StaticResource CardBackgroundBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding CopyStatusMessage}"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CopySucceeded}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="CopyButton"
                                MinWidth="112"
                                automation:AutomationProperties.Name="Copy error details"
                                Command="{Binding CopyDetailsCommand}"
                                Content="Copy Details"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <Button MinWidth="92"
                                Margin="10,0,0,0"
                                automation:AutomationProperties.Name="Close error details"
                                Click="CloseButton_Click"
                                Content="Close"
                                IsCancel="True" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
