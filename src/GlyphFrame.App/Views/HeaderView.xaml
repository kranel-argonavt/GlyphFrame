<UserControl x:Class="GlyphFrame.App.Views.HeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GlyphFrame.App.Views"
             Focusable="False">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <views:BrandLogo Margin="0,0,14,0" VerticalAlignment="Center"
                         Style="{StaticResource BrandLogoStyle}" />

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Margin="0,0,0,3"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentHoverBrush}"
                       Text="GLYPHFRAME" />
            <TextBlock Style="{StaticResource ProductTitleTextStyle}"
                       Text="Video &amp; Image to Symbol Converter" />
            <TextBlock Margin="0,3,0,0"
                       Style="{StaticResource ProductDescriptionTextStyle}"
                       Text="Transform videos and images into beautiful symbol art" />
        </StackPanel>

    </Grid>
</UserControl>
