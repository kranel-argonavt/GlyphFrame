<UserControl x:Class="GlyphFrame.App.Views.HeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border Width="54"
                Height="54"
                Margin="0,0,14,0"
                VerticalAlignment="Center"
                Background="{StaticResource AccentSubtleBrush}"
                BorderBrush="{StaticResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid>
                <Border Width="28"
                        Height="28"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="6" />
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="White"
                           Text="GF" />
            </Grid>
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Margin="0,0,0,3"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AccentHoverBrush}"
                       Text="GLYPHFRAME" />
            <TextBlock Style="{StaticResource ProductTitleTextStyle}"
                       Text="Video &amp; Image to Symbol Converter" />
            <TextBlock Margin="0,3,0,0"
                       Style="{StaticResource ProductDescriptionTextStyle}"
                       Text="Transform videos and images into beautiful symbol art" />
        </StackPanel>

        <Grid Grid.Column="2" Margin="24,0,0,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="210" />
            </Grid.ColumnDefinitions>
            <TextBlock Margin="0,0,12,0"
                       Style="{StaticResource LabelTextStyle}"
                       Text="Presets" />
            <ComboBox Grid.Column="1"
                      DisplayMemberPath="Name"
                      ItemsSource="{Binding Presets}"
                      SelectedItem="{Binding SelectedPreset}"
                      ToolTip="Select the character preset used by future symbol previews" />
        </Grid>
    </Grid>
</UserControl>
