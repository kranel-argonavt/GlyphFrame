<UserControl x:Class="GlyphFrame.App.Views.ExportActivityIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False"
             IsHitTestVisible="False">
    <Grid>
        <Ellipse Fill="{DynamicResource PanelBackgroundBrush}"
                 Stroke="{DynamicResource BorderBrush}"
                 StrokeThickness="3" />
        <Path x:Name="RingSegments"
              Margin="2"
              Opacity="0.9"
              RenderTransformOrigin="0.5,0.5"
              SizeChanged="OnRingSegmentsSizeChanged"
              Stretch="None"
              Stroke="{DynamicResource AccentBrush}"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              StrokeThickness="3">
            <Path.RenderTransform>
                <RotateTransform x:Name="RingRotation" />
            </Path.RenderTransform>
        </Path>
        <TextBlock x:Name="PercentagePresenter"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontFamily="Segoe UI"
                   FontSize="14"
                   FontWeight="SemiBold" />
        <Viewbox x:Name="CompletionPresenter"
                 Width="30"
                 Height="30"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Opacity="0"
                 RenderTransformOrigin="0.5,0.5"
                 Visibility="Collapsed">
            <Viewbox.RenderTransform>
                <ScaleTransform x:Name="CompletionScale" ScaleX="0.86" ScaleY="0.86" />
            </Viewbox.RenderTransform>
            <Path Data="M 3,12 L 9,18 L 21,5"
                  Fill="Transparent"
                  Stroke="{DynamicResource SuccessBrush}"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  StrokeStartLineCap="Round"
                  StrokeThickness="3" />
        </Viewbox>
    </Grid>
</UserControl>
