<UserControl x:Class="GlyphFrame.App.Views.ExportStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Margin="0,10,0,0"
             Focusable="False"
             Visibility="{Binding IsExportActive, Converter={StaticResource BooleanToVisibilityConverter}}">
    <Border Style="{StaticResource CardStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Width="72" Height="72" HorizontalAlignment="Left" VerticalAlignment="Center">
                <Ellipse Fill="{StaticResource PanelBackgroundBrush}"
                         Stroke="{StaticResource BorderBrush}"
                         StrokeThickness="7" />
                <Ellipse Margin="5"
                         Stroke="{StaticResource AccentBrush}"
                         StrokeDashArray="5,2"
                         StrokeThickness="5" />
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Text="{Binding ExportPercentageText}" />
            </Grid>

            <Grid Grid.Column="1" Margin="0,0,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}"
                           Text="{Binding ExportOperationTitle}" />
                <TextBlock Grid.Row="1"
                           Margin="0,4,0,0"
                           Style="{StaticResource SecondaryTextStyle}"
                           Text="{Binding ExportProgressText}" />
                <ProgressBar Grid.Row="2"
                             Margin="0,10,0,0"
                             Maximum="100"
                             Value="{Binding ExportProgress}" />
                <StackPanel Grid.Row="3" Margin="0,9,0,0" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="{Binding ElapsedText}" />
                    <TextBlock Margin="24,0,0,0" Style="{StaticResource MutedTextStyle}" Text="{Binding RemainingText}" />
                </StackPanel>
            </Grid>

            <Button Grid.Column="2"
                    Width="96"
                    VerticalAlignment="Center"
                    Command="{Binding CancelExportCommand}"
                    Content="Cancel"
                    Style="{StaticResource DangerButtonStyle}" />
        </Grid>
    </Border>
</UserControl>
