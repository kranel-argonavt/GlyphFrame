<UserControl x:Class="GlyphFrame.App.Views.ExportStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:presentation="clr-namespace:GlyphFrame.App.Presentation"
             xmlns:views="clr-namespace:GlyphFrame.App.Views"
             Margin="0,10,0,0"
             Focusable="False"
             Visibility="{Binding IsExportStatusVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
    <Border Style="{StaticResource CardStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <views:ExportActivityIndicator Width="72"
                                           Height="72"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           AnimationsEnabled="{Binding AreExportAnimationsEnabled}"
                                           IsActive="{Binding IsExportActive}"
                                           IsCompleted="{Binding IsExportCompletionVisible}"
                                           PercentageText="{Binding ExportPercentageText}" />

            <Grid Grid.Column="1" Margin="0,0,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource SectionHeaderTextStyle}"
                           Text="{Binding ExportOperationTitle}" />
                <TextBlock Grid.Row="1"
                           Margin="0,4,0,0"
                           presentation:ExportStatusAnimation.AnimationsEnabled="{Binding AreExportAnimationsEnabled}"
                           presentation:ExportStatusAnimation.Stage="{Binding ExportStage}"
                           presentation:ExportStatusAnimation.StageText="{Binding ExportProgressText}"
                           Style="{StaticResource SecondaryTextStyle}"
                           Text="" />
                <TextBlock Grid.Row="2"
                           Margin="0,4,0,0"
                           Style="{StaticResource MutedTextStyle}"
                           Text="{Binding ExportFrameText}" />
                <ProgressBar Grid.Row="3"
                             Margin="0,10,0,0"
                             Maximum="100"
                             presentation:ExportStatusAnimation.AnimationsEnabled="{Binding AreExportAnimationsEnabled}"
                             presentation:ExportStatusAnimation.ProgressGeneration="{Binding ExportPresentationGeneration}"
                             presentation:ExportStatusAnimation.ProgressIsIndeterminate="{Binding IsExportProgressIndeterminate}"
                             presentation:ExportStatusAnimation.ProgressStage="{Binding ExportStage}"
                             presentation:ExportStatusAnimation.ProgressValue="{Binding ExportProgress}" />
                <StackPanel Grid.Row="4" Margin="0,9,0,0" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="{Binding ElapsedText}" />
                    <TextBlock Margin="24,0,0,0" Style="{StaticResource MutedTextStyle}" Text="{Binding RemainingText}" />
                </StackPanel>
            </Grid>

            <Button Grid.Column="2"
                    Width="96"
                    VerticalAlignment="Center"
                    Command="{Binding CancelExportCommand}"
                    Content="Cancel"
                    Style="{StaticResource DangerButtonStyle}"
                    Visibility="{Binding IsExportActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
    </Border>
</UserControl>
