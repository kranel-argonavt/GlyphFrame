<Window x:Class="GlyphFrame.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GlyphFrame.App.Views"
        Title="GlyphFrame Settings"
        Icon="{StaticResource GlyphFrameWindowIcon}"
        Width="720"
        Height="760"
        MinWidth="620"
        MinHeight="620"
        Background="{StaticResource MainBackgroundBrush}"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="SelectablePathStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="24,20,24,16"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock FontSize="20"
                           FontWeight="SemiBold"
                           Text="Settings" />
                <TextBlock Margin="0,5,0,0"
                           Style="{StaticResource SecondaryTextStyle}"
                           Text="Local appearance and editor defaults"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Padding="24,18,18,18"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,6,0">
                <Border Margin="0,0,0,12" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                            <Border Style="{StaticResource SectionIconStyle}">
                                <Path Data="M 12,2 L 13.5,7.5 L 19,9 L 13.5,10.5 L 12,16 L 10.5,10.5 L 5,9 L 10.5,7.5 Z M 19,15 L 20,18 L 23,19 L 20,20 L 19,23 L 18,20 L 15,19 L 18,18 Z"
                                      Style="{StaticResource SectionIconGlyphStyle}" />
                            </Border>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Appearance" />
                                <TextBlock Margin="0,3,0,0"
                                           Style="{StaticResource MutedTextStyle}"
                                           Text="Choose an accent color for the dark theme." TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="Accent preset" />
                            <ComboBox x:Name="AccentPresetComboBox"
                                      Grid.Column="1"
                                      AutomationProperties.Name="Accent preset"
                                      DisplayMemberPath="DisplayName"
                                      ItemsSource="{Binding AccentPresets}"
                                      SelectedValue="{Binding SelectedAccentPreset}"
                                      SelectedValuePath="Value"
                                      ToolTip="Choose an accent color" />
                            <Border Grid.Column="2"
                                    Width="36"
                                    Height="36"
                                    Margin="10,0,0,0"
                                    Background="{Binding AccentPreviewColor}"
                                    BorderBrush="{StaticResource PrimaryTextBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    ToolTip="Current accent preview" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,0,0,12" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                            <Border Style="{StaticResource SectionIconStyle}">
                                <Path Data="M 3,5 H 9 V 3 H 13 V 5 H 21 V 7 H 13 V 9 H 9 V 7 H 3 Z M 3,11 H 15 V 9 H 19 V 11 H 21 V 13 H 19 V 15 H 15 V 13 H 3 Z M 3,17 H 6 V 15 H 10 V 17 H 21 V 19 H 10 V 21 H 6 V 19 H 3 Z"
                                      Style="{StaticResource SectionIconGlyphStyle}" />
                            </Border>
                            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Defaults" />
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="Character preset" />
                            <ComboBox Grid.Column="1"
                                      DisplayMemberPath="Name"
                                      ItemsSource="{Binding CharacterPresets}"
                                      SelectedItem="{Binding SelectedCharacterPreset}" />

                            <TextBlock Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource LabelTextStyle}" Text="Font family" />
                            <ComboBox Grid.Row="1"
                                      Grid.Column="1"
                                      Margin="0,10,0,0"
                                      ItemsSource="{Binding FontFamilies}"
                                      SelectedItem="{Binding SelectedFontFamily}" />

                            <TextBlock Grid.Row="2" Margin="0,10,0,0" Style="{StaticResource LabelTextStyle}" Text="Font size" />
                            <ComboBox Grid.Row="2"
                                      Grid.Column="1"
                                      Margin="0,10,0,0"
                                      ItemsSource="{Binding FontSizes}"
                                      SelectedItem="{Binding SelectedFontSize}" />

                            <TextBlock Grid.Row="3" Margin="0,10,0,0" Style="{StaticResource LabelTextStyle}" Text="Output resolution" />
                            <ComboBox Grid.Row="3"
                                      Grid.Column="1"
                                      Margin="0,10,0,0"
                                      DisplayMemberPath="DisplayName"
                                      ItemsSource="{Binding OutputResolutions}"
                                      SelectedValue="{Binding SelectedOutputResolution}"
                                      SelectedValuePath="Value" />

                            <TextBlock Grid.Row="4" Margin="0,10,0,0" Style="{StaticResource LabelTextStyle}" Text="Symbol polarity" />
                            <ComboBox Grid.Row="4"
                                      Grid.Column="1"
                                      Margin="0,10,0,0"
                                      DisplayMemberPath="DisplayName"
                                      ItemsSource="{Binding SymbolPolarities}"
                                      SelectedValue="{Binding SelectedSymbolPolarity}"
                                      SelectedValuePath="Value"
                                      ToolTip="Choose whether bright or dark image areas use denser symbols." />

                            <TextBlock Grid.Row="5" Margin="0,10,0,0" Style="{StaticResource LabelTextStyle}" Text="Default image export format" TextWrapping="Wrap" />
                            <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,10,0,0">
                                <ComboBox x:Name="ImageExportFormatComboBox"
                                      AutomationProperties.Name="Default image export format"
                                      AutomationProperties.HelpText="Initial format in the image Save dialog. You can change it there."
                                      DisplayMemberPath="DisplayName"
                                      ItemsSource="{Binding ImageExportFormats}"
                                      SelectedValue="{Binding SelectedImageExportFormat}"
                                      SelectedValuePath="Value" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                                           Text="Initial format in the image Save dialog. You can change it there." />
                            </StackPanel>

                            <TextBlock Grid.Row="6" Margin="0,10,0,0" Style="{StaticResource LabelTextStyle}" Text="Video audio mode" />
                            <ComboBox Grid.Row="6"
                                      Grid.Column="1"
                                      Margin="0,10,0,0"
                                      DisplayMemberPath="DisplayName"
                                      ItemsSource="{Binding AudioModes}"
                                      SelectedValue="{Binding SelectedVideoAudioMode}"
                                      SelectedValuePath="Value" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                            <Border Style="{StaticResource SectionIconStyle}">
                                <Path Data="F 0 M 3,5 H 9 L 11,7 H 21 V 19 H 3 Z M 5,9 V 17 H 19 V 9 Z"
                                      Style="{StaticResource SectionIconGlyphStyle}" />
                            </Border>
                            <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Application" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="Application-data location" />
                        <Border Margin="0,6,0,12" Style="{StaticResource ReadOnlySurfaceStyle}">
                            <TextBox x:Name="ApplicationDataPath" Style="{StaticResource SelectablePathStyle}"
                                       AutomationProperties.Name="Application-data folder path"
                                       Text="{Binding ApplicationDataDirectory, Mode=OneWay}"
                                       ToolTip="{Binding ApplicationDataDirectory}" />
                        </Border>

                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="Logs-folder location" />
                        <Grid Margin="0,6,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Margin="0,0,10,0" Style="{StaticResource ReadOnlySurfaceStyle}">
                                <TextBox x:Name="LogsFolderPath" Style="{StaticResource SelectablePathStyle}"
                                           AutomationProperties.Name="Logs folder path"
                                           Text="{Binding LogsDirectory, Mode=OneWay}"
                                           ToolTip="{Binding LogsDirectory}" />
                            </Border>
                            <Button Grid.Column="1"
                                    MinWidth="128"
                                    Command="{Binding OpenLogsFolderCommand}"
                                    Content="Open logs folder" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="Bundled FFmpeg tools" />
                            <Button Grid.Column="1"
                                    MinWidth="88"
                                    Padding="12,5"
                                    Command="{Binding RefreshFfmpegCommand}"
                                    Content="Refresh"
                                    ToolTip="Validate ffmpeg.exe and ffprobe.exe again" />
                        </Grid>
                        <Border Margin="0,6,0,8" Style="{StaticResource ReadOnlySurfaceStyle}">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           Text="{Binding FfmpegAvailability}" />
                                <TextBlock Margin="0,4,0,0"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Text="{Binding FfmpegStatusMessage}"
                                           TextWrapping="Wrap" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="FFmpeg" />
                                    <TextBlock Grid.Column="1"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Text="{Binding FfmpegVersion}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding FfmpegVersion}" />
                                    <TextBlock Grid.Row="1"
                                               Margin="0,4,0,0"
                                               Style="{StaticResource MutedTextStyle}"
                                               Text="ffprobe" />
                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               Margin="0,4,0,0"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               Text="{Binding FfprobeVersion}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding FfprobeVersion}" />
                                </Grid>
                                <Button Margin="0,8,0,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding ShowFfmpegErrorDetailsCommand}"
                                        Content="Show Details"
                                        Style="{StaticResource TextButtonStyle}"
                                        Visibility="{Binding ShowFfmpegErrorDetails, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="Bundled-tools location" />
                        <Border Margin="0,6,0,0" Style="{StaticResource ReadOnlySurfaceStyle}">
                            <TextBlock Foreground="{StaticResource SecondaryTextBrush}"
                                       Text="{Binding BundledToolsDirectory}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding BundledToolsDirectory}" />
                        </Border>


                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="24,14"
                Background="{StaticResource CardBackgroundBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel>
                <TextBlock x:Name="SettingsFeedback" Margin="0,0,0,12"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Text="{Binding StatusMessage}" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"
                           Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:SettingsActionsPanel>
                    <Button Height="Auto" MinHeight="{StaticResource ControlHeight}" Command="{Binding ResetCommand}" Content="Reset to defaults" />
                    <Button Height="Auto" MinHeight="{StaticResource ControlHeight}" MinWidth="92" Command="{Binding CancelCommand}" Content="Cancel" IsCancel="True" />
                    <Button Height="Auto" MinHeight="{StaticResource ControlHeight}" MinWidth="116" Command="{Binding SaveCommand}" Content="Save &amp; Close"
                            IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" />
                </views:SettingsActionsPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
