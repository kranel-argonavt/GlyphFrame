<UserControl x:Class="GlyphFrame.App.Views.SettingsPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:GlyphFrame.App.Behaviors"
             xmlns:views="clr-namespace:GlyphFrame.App.Views" Focusable="False">
    <views:SettingsPanePanel x:Name="SettingsComposition"
                            ViewportHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Border x:Name="InputCard" Style="{StaticResource CardStyle}" Padding="12,8">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource HeadingIconStyle}" Data="{StaticResource FolderIcon}" />
                        <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Input" />
                    </StackPanel>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="InputFileName" FontWeight="SemiBold" Text="{Binding InputDisplayName}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedFilePath}"
                                       AutomationProperties.HelpText="{Binding SelectedFilePath}" />
                        </Grid>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding BrowseMediaCommand}" Content="{Binding BrowseMediaActionLabel}"
                            AutomationProperties.HelpText="Select one local PNG, JPG/JPEG, WebP, BMP, MP4, MOV, MKV or AVI file"
                            ToolTip="Choose a local image or video" AutomationProperties.Name="{Binding BrowseMediaActionLabel}" />
                </Grid>
                <WrapPanel x:Name="InputSummaryLine" Margin="0,3,0,0">
                    <StackPanel x:Name="SourceReady" Orientation="Horizontal" Margin="0,0,6,0"
                                ToolTip="{Binding InputReadinessText}"
                                Visibility="{Binding IsInputReady, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Ellipse Width="5" Height="5" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="Source ready" />
                        <TextBlock Margin="6,0,0,0" Style="{StaticResource MutedTextStyle}" Text="·" />
                    </StackPanel>
                    <TextBlock x:Name="InputMetadata" Style="{StaticResource MutedTextStyle}" Text="{Binding InputCardSummary}" TextWrapping="Wrap" />
                </WrapPanel>
                <StackPanel Visibility="{Binding HasMediaInputError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Margin="0,5,0,0" Foreground="{DynamicResource ErrorBrush}" Text="{Binding InputStatusMessage}" TextWrapping="Wrap" />
                    <Button HorizontalAlignment="Left" Command="{Binding ShowMediaInputErrorDetailsCommand}" Content="Show Details"
                            Style="{StaticResource TextButtonStyle}"
                            Visibility="{Binding ShowRetainedMediaInputErrorDetails, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
                <Border Margin="0,8,0,0" Padding="8,6" MinHeight="30" IsEnabled="{Binding IsBrowseMediaAvailable}"
                        behaviors:MediaDropBehavior.Command="{Binding DropMediaCommand}" behaviors:MediaDropBehavior.IsEnabled="True"
                        CornerRadius="{StaticResource ControlCornerRadius}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource PreviewBackgroundBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <Trigger Property="behaviors:MediaDropBehavior.IsDragOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource LocalDropIcon}" Margin="0,0,8,0" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="{Binding InputDropText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
        <Border x:Name="CharactersCard" Style="{StaticResource CardStyle}" Padding="12,8" IsEnabled="{Binding AreSettingsEnabled}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Path Style="{StaticResource HeadingIconStyle}" Data="{StaticResource CharactersIcon}" />
                        <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Characters" />
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="Preset" />
                    <ComboBox x:Name="PresetField" Grid.Column="1" DisplayMemberPath="Name" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                              ToolTip="Character preset" AutomationProperties.Name="Character preset" />
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock x:Name="RampLabel" Style="{StaticResource LabelTextStyle}" Text="Ramp" />
                        <Border x:Name="RampField" Grid.Column="1" Style="{StaticResource ReadOnlySurfaceStyle}">
                            <TextBlock Style="{StaticResource MonospaceTextStyle}" Text="{Binding CharacterRamp}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CharacterRamp}" />
                        </Border>
                        <Grid Grid.Column="1" Grid.Row="1" Margin="0,4,0,0">
                            <TextBlock HorizontalAlignment="Left" Style="{StaticResource MutedTextStyle}" Text="Sparse" />
                            <Border Height="1" Margin="48,0" VerticalAlignment="Center" Background="{DynamicResource BorderBrush}" />
                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource MutedTextStyle}" Text="Dense" />
                        </Grid>
                </Grid>
            </StackPanel>
        </Border>
        <Border x:Name="RenderCard" Style="{StaticResource CardStyle}" Padding="12,8">
            <views:RenderSettingsPanel x:Name="RenderComposition">
                    <StackPanel x:Name="RenderHeading" Orientation="Horizontal" Margin="0,0,0,8">
                        <Path Style="{StaticResource HeadingIconStyle}" Data="{StaticResource RenderSettingsIcon}" />
                        <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Render" />
                    </StackPanel>
                <ScrollViewer x:Name="RenderParameterScroller" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <StackPanel IsEnabled="{Binding AreSettingsEnabled}">
                    <views:FontSettingsPanel x:Name="FontFields">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="Font family" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding SelectedFont}" AutomationProperties.Name="Font family" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="Font size" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding FontSizes}" SelectedItem="{Binding SelectedFontSize}" AutomationProperties.Name="Font size" />
                        </Grid>
                    </views:FontSettingsPanel>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="Resolution" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding OutputResolutions}" SelectedItem="{Binding SelectedOutputResolution}" AutomationProperties.Name="Output resolution" />
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="Symbol polarity" TextWrapping="Wrap" />
                        <ComboBox Grid.Column="1" DisplayMemberPath="DisplayName" ItemsSource="{Binding SymbolPolarities}" SelectedValue="{Binding SelectedSymbolPolarity}" SelectedValuePath="Value"
                                  ToolTip="Choose whether bright or dark image areas use denser symbols." AutomationProperties.Name="Symbol polarity" />
                    </Grid>
                    <Border Margin="0,8,0,0" Style="{StaticResource ReadOnlySurfaceStyle}" AutomationProperties.Name="Original colors, fixed in this version">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path Style="{StaticResource VectorIconStyle}" Data="{StaticResource LockIcon}" />
                            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Original colors" Margin="0,0,12,0" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="Fixed in this version" VerticalAlignment="Center" />
                            </WrapPanel>
                        </Grid>
                    </Border>
                </StackPanel>
                </ScrollViewer>
                <StackPanel x:Name="VideoAudioSection" Margin="0,8,0,0">
                    <Border Style="{StaticResource DividerStyle}" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource HeadingIconStyle}" Data="{StaticResource SpeakerIcon}" />
                        <TextBlock FontWeight="SemiBold" Text="Video audio" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Margin="0,4,0,8" Style="{StaticResource MutedTextStyle}" Text="Applies to the rendered video." TextWrapping="Wrap" />
                    <Grid>
                    <Grid x:Name="AudioButtons" IsEnabled="{Binding AreVideoAudioSettingsEnabled}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowVideoAudioUnavailableOverlay}" Value="True">
                                        <Setter Property="Opacity" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <RadioButton Margin="0,0,4,0" Content="Keep Audio" GroupName="AudioMode" IsChecked="{Binding IsKeepAudioSelected}" Style="{StaticResource SegmentRadioButtonStyle}" AutomationProperties.Name="Keep audio in rendered video" />
                        <RadioButton Grid.Column="1" Margin="4,0,0,0" Content="Remove Audio" GroupName="AudioMode" IsChecked="{Binding IsRemoveAudioSelected}" Style="{StaticResource SegmentRadioButtonStyle}" AutomationProperties.Name="Remove audio from rendered video" />
                    </Grid>
                        <Border x:Name="AudioUnavailableSurface" Background="{DynamicResource PreviewBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource ControlCornerRadius}" IsHitTestVisible="False" Focusable="False" Cursor="Arrow"
                                Visibility="{Binding ShowVideoAudioUnavailableOverlay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Margin="6,0" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Text="{Binding VideoAudioUnavailableReason}" />
                        </Border>
                    </Grid>
                </StackPanel>
                <StackPanel x:Name="ComingSoon" Opacity="0.65" IsHitTestVisible="False" Focusable="False" HorizontalAlignment="Center">
                    <TextBlock Text="More render settings" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Text="Coming soon" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </views:RenderSettingsPanel>
        </Border>
    </views:SettingsPanePanel>
</UserControl>
