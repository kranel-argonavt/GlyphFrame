<Window x:Class="GlyphFrame.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GlyphFrame.App.Views"
        Title="{Binding ApplicationInfo.Name}"
        views:ThemedWindowIcon.Source="{DynamicResource GlyphFrameWindowIcon}"
        Width="1320"
        Height="820"
        MinWidth="1024"
        MinHeight="720"
        Background="{StaticResource MainBackgroundBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <views:HeaderView Grid.Row="0" Margin="22,18,22,18" />

        <Grid Grid.Row="1" Margin="22,0,22,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="LeftPaneScrollViewer"
                          Grid.Column="0"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly"
                          VerticalScrollBarVisibility="Visible">
                <views:ReviewPanePanel ViewportHeight="{Binding ActualHeight, ElementName=LeftPaneScrollViewer}"
                                       ReserveStatusSpace="{Binding IsMediaSelected}">
                    <views:PreviewPanelView />
                    <views:ExportStatusView />
                </views:ReviewPanePanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SettingsPaneScrollViewer" Grid.Column="2"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly"
                          VerticalScrollBarVisibility="Visible">
                <views:SettingsPanelView Margin="0,0,4,0" />
            </ScrollViewer>
        </Grid>

        <views:FooterView Grid.Row="2" />
    </Grid>
</Window>
