<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\GlyphFrame.ico</ApplicationIcon>
    <GlyphFrameFfmpegDirectory Condition="'$(GlyphFrameFfmpegDirectory)' == ''">$(MSBuildProjectDirectory)\..\..\artifacts\local-runtime\controlled-9.0-glyphframe.2\Tools\ffmpeg</GlyphFrameFfmpegDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GlyphFrame.Core\GlyphFrame.Core.csproj" />
    <ProjectReference Include="..\GlyphFrame.Infrastructure\GlyphFrame.Infrastructure.csproj" />
    <ProjectReference Include="..\GlyphFrame.Rendering\GlyphFrame.Rendering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\LICENSE" Link="LICENSE"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\**\*" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(GlyphFrameFfmpegDirectory)\ffmpeg.exe" Condition="Exists('$(GlyphFrameFfmpegDirectory)\ffmpeg.exe')"
             Link="Tools\ffmpeg\ffmpeg.exe"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(GlyphFrameFfmpegDirectory)\ffprobe.exe" Condition="Exists('$(GlyphFrameFfmpegDirectory)\ffprobe.exe')"
             Link="Tools\ffmpeg\ffprobe.exe"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\Tools\ffmpeg\SHA256SUMS.txt"
             Link="Tools\ffmpeg\SHA256SUMS.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\Tools\ffmpeg\LICENSE.txt"
             Link="Tools\ffmpeg\LICENSE.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\Tools\ffmpeg\DISTRIBUTION_README.txt"
             Link="Tools\ffmpeg\DISTRIBUTION_README.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD_PARTY_NOTICES.md"
             Link="THIRD_PARTY_NOTICES.md"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="ExplainMissingLocalVideoTools" BeforeTargets="Build"
          Condition="!Exists('$(GlyphFrameFfmpegDirectory)\ffmpeg.exe') Or !Exists('$(GlyphFrameFfmpegDirectory)\ffprobe.exe')">
    <Message Importance="high" Text="Local FFmpeg tools are absent: image workflows remain available; initialize video tools with scripts/Initialize-LocalTools.ps1, then rebuild. See Tools/ffmpeg/README.md." />
  </Target>

</Project>
